{
  "info": {
    "_postman_id": "b3c89f50-6d42-4f9e-9988-mini-banking-v2",
    "name": "Mini Banking API (Complete Portfolio)",
    "description": "Complete Postman Collection for Mini Banking API - Includes JWT Authentication, Account Management, Deposit/Withdraw, @Transactional Fund Transfers with Rollback proof, and Paginated Statements.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "sourceAccount",
      "value": "",
      "type": "string"
    },
    {
      "key": "targetAccount",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. System Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/health"
          }
        }
      ]
    },
    {
      "name": "1. Authentication & JWT",
      "item": [
        {
          "name": "Register User 1 (Sender)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('token', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Alice Sender\",\n  \"email\": \"alice@bank.com\",\n  \"password\": \"password123\",\n  \"role\": \"ROLE_USER\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/register"
          }
        },
        {
          "name": "Register User 2 (Receiver)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Bob Receiver\",\n  \"email\": \"bob@bank.com\",\n  \"password\": \"password123\",\n  \"role\": \"ROLE_USER\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/register"
          }
        },
        {
          "name": "Login (Alice)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('token', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@bank.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        }
      ]
    },
    {
      "name": "2. Bank Accounts",
      "item": [
        {
          "name": "Open Account (Alice - Checking)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accountNumber) {",
                  "    pm.collectionVariables.set('sourceAccount', jsonData.accountNumber);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountType\": \"CHECKING\",\n  \"initialDeposit\": 1000.00\n}"
            },
            "url": "{{baseUrl}}/api/v1/accounts"
          }
        },
        {
          "name": "Get My Accounts",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "{{baseUrl}}/api/v1/accounts/me"
          }
        },
        {
          "name": "Get Account Details & Balance",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "{{baseUrl}}/api/v1/accounts/{{sourceAccount}}"
          }
        },
        {
          "name": "Deposit Funds",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountNumber\": \"{{sourceAccount}}\",\n  \"amount\": 250.00,\n  \"description\": \"Paycheck bonus\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/accounts/deposit"
          }
        },
        {
          "name": "Withdraw Funds",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountNumber\": \"{{sourceAccount}}\",\n  \"amount\": 50.00,\n  \"description\": \"ATM Cash\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/accounts/withdraw"
          }
        }
      ]
    },
    {
      "name": "3. Fund Transfers & @Transactional",
      "item": [
        {
          "name": "Safe Atomic Transfer (Success)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceAccountNumber\": \"{{sourceAccount}}\",\n  \"targetAccountNumber\": \"{{targetAccount}}\",\n  \"amount\": 150.00,\n  \"description\": \"Shared dinner expense\",\n  \"simulateFailure\": false\n}"
            },
            "url": "{{baseUrl}}/api/v1/transfers"
          }
        },
        {
          "name": "Demonstrate Rollback (simulateFailure = true)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceAccountNumber\": \"{{sourceAccount}}\",\n  \"targetAccountNumber\": \"{{targetAccount}}\",\n  \"amount\": 100.00,\n  \"description\": \"Forced rollback test\",\n  \"simulateFailure\": true\n}"
            },
            "url": "{{baseUrl}}/api/v1/transfers"
          }
        },
        {
          "name": "Error: Insufficient Funds",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceAccountNumber\": \"{{sourceAccount}}\",\n  \"targetAccountNumber\": \"{{targetAccount}}\",\n  \"amount\": 999999.00,\n  \"description\": \"Overdraft\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/transfers"
          }
        },
        {
          "name": "Error: Self Transfer",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceAccountNumber\": \"{{sourceAccount}}\",\n  \"targetAccountNumber\": \"{{sourceAccount}}\",\n  \"amount\": 10.00,\n  \"description\": \"Self transfer\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/transfers"
          }
        }
      ]
    },
    {
      "name": "4. Statements & History",
      "item": [
        {
          "name": "Get Account Statement (Paginated)",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "{{baseUrl}}/api/v1/accounts/{{sourceAccount}}/transactions?page=0&size=10"
          }
        }
      ]
    }
  ]
}
